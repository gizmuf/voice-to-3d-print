PULSAI_ALLOW_PLATFORM_AI_SPEND=false
PULSAI_ALLOW_PUBLIC_ARTIFACTS=false
PULSAI_AUTH_REQUIRED=true
PULSAI_INSECURE_LOCAL_DEV=false
PULSAI_PUBLIC_SAFE_MODE=true
PULSAI_ALLOW_UNTRUSTED_CAD_CODE=false
# Public OAuth client identifier from Google Cloud Console (never a secret).
GOOGLE_OAUTH_CLIENT_ID=
PULSAI_BYOK_ENCRYPTION_KEY=
CORS_ORIGINS=https://3d.pulsai.app

DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3

# Legacy workspace endpoint only. Leave empty unless a dedicated 3D-owned
# Gemini proxy is deployed.
GEMINI_PROXY_URL=
GEMINI_MODEL=gemini-2.5-flash

FIREBASE_PROJECT_ID=pulsai-app
FIREBASE_STORAGE_BUCKET=pulsai-app-assets
STORAGE_PUBLIC_BASE_URL=

ANTHROPIC_API_KEY=
# Optional authenticated accounts entitled to the server-side Anthropic key.
# In production mount this from Secret Manager; never expose it to Next.js.
ANTHROPIC_PLATFORM_EMAIL_ALLOWLIST=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_OUTPUT_TOKENS=1500
ANTHROPIC_RETRY_MAX_ATTEMPTS=3
ANTHROPIC_RETRY_BASE_DELAY_S=0.5
ANTHROPIC_RETRY_MAX_DELAY_S=8
ANTHROPIC_CIRCUIT_FAILURE_THRESHOLD=3
ANTHROPIC_CIRCUIT_COOLDOWN_S=30
ANTHROPIC_TIMEOUT_S=120
# VPS alternative: point to a root/service-owned secret mount instead of
# placing the value in an env file.
ANTHROPIC_API_KEY_FILE=

THREED_PROVIDER=parametric

MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai
MESHY_CREATE_ENDPOINT=/openapi/v2/text-to-3d
MESHY_STATUS_ENDPOINT=/openapi/v2/text-to-3d/{task_id}
MESHY_IMAGE_CREATE_ENDPOINT=/openapi/v1/image-to-3d
MESHY_IMAGE_STATUS_ENDPOINT=/openapi/v1/image-to-3d/{task_id}

TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.ai
TRIPO_CREATE_ENDPOINT=/v2/openapi/task
TRIPO_STATUS_ENDPOINT=/v2/openapi/task/{task_id}
TRIPO_UPLOAD_ENDPOINT=/v2/openapi/upload/sts

TRELLIS2_API_URL=
TRELLIS2_IMAGE_ENDPOINT=/image-to-3d
TRELLIS2_TEXT_ENDPOINT=
TRELLIS2_STATUS_ENDPOINT=
TRELLIS2_PIPELINE_TYPE=1024_cascade
TRELLIS2_SEED=

TRIPOSR_ROOT=
TRIPOSR_PYTHON=python3
TRIPOSR_DEVICE=cpu
TRIPOSR_MODEL=stabilityai/TripoSR
TRIPOSR_CACHE_DIR=
TRIPOSR_TIMEOUT_S=3600
TRIPOSR_CHUNK_SIZE=
TRIPOSR_MC_RESOLUTION=
TRIPOSR_NO_REMOVE_BG=
TRIPOSR_BAKE_TEXTURE=
TRIPOSR_TEXTURE_RESOLUTION=

SKETCHFAB_API_TOKEN=
SKETCHFAB_BASE_URL=https://api.sketchfab.com/v3

# Optional jewelry concept generation. Upload/trace works without this.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5

ONSHAPE_BASE_URL=https://cad.onshape.com
# Development/server-side import mode. API keys act as the Onshape user who
# created them; use OAuth for a public multi-user app.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# Optional OAuth scaffold. Register the callback in the Onshape dev portal.
ONSHAPE_OAUTH_CLIENT_ID=
ONSHAPE_OAUTH_CLIENT_SECRET=
ONSHAPE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/onshape/oauth/callback
ONSHAPE_OAUTH_AUTHORIZE_URL=https://oauth.onshape.com/oauth/authorize
ONSHAPE_OAUTH_TOKEN_URL=https://oauth.onshape.com/oauth/token

PRUSASLICER_PATH=/Applications/PrusaSlicer.app/Contents/MacOS/PrusaSlicer
PRUSASLICER_CONFIG=config.ini
OUTPUT_DIR=./data/output
MODEL_LIBRARY_PATH=./data/model_library.json

MESH_MERGE_TOLERANCE=0.0005
