# Backend
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
THREED_PROVIDER=meshy
MESHY_API_KEY=
TRIPO_API_KEY=

MESHY_BASE_URL=https://api.meshy.ai
TRIPO_BASE_URL=https://api.tripo.ai
MESHY_CREATE_ENDPOINT=/v1/text-to-3d
MESHY_STATUS_ENDPOINT=/v1/text-to-3d/{task_id}
TRIPO_CREATE_ENDPOINT=/v1/task
TRIPO_STATUS_ENDPOINT=/v1/task/{task_id}

PRUSASLICER_PATH=/Applications/PrusaSlicer.app/Contents/MacOS/PrusaSlicer
PRUSASLICER_CONFIG=/path/to/config.ini
OUTPUT_DIR=backend/data/output
MESH_MERGE_TOLERANCE=0.0005

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_PIPECAT_URL=http://localhost:7860
